    cursor: 'pointer'
  },

  steps: {
    maxWidth: '1200px',
    margin: '0 auto',
    padding: '20px 30px 90px',
    display: 'grid',
    gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))',
    gap: '18px'
  },

  step: {
    padding: '28px',
    background: '#131a2e',
    border: '1px solid #202942',
    borderRadius: '16px'
  },

  stepNumber: {
