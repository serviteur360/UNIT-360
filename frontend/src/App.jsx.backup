    marginBottom: '12px'
  },

  stepText: {
    color: '#9da7bd',
    lineHeight: '1.6'
  },

  sectionTitle: {
    maxWidth: '1200px',
    margin: '0 auto 30px',
    padding: '0 30px',
    fontSize: '36px'
  },

  modules: {
    maxWidth: '1200px',
    margin: '0 auto',
    padding: '0 30px 90px',
    display: 'grid',
    gridTemplateColumns: 'repeat(auto-fit, minmax(250px, 1fr))',
    gap: '18px'
  },

  module: {
    padding: '30px',
    background: '#11182b',
    border: '1px solid #202942',
    borderRadius: '16px'
  },

  moduleIcon: {
    fontSize: '32px',
    marginBottom: '18px'
  },

  moduleTitle: {
    fontSize: '21px',
    marginBottom: '10px'
  },

  moduleText: {
    color: '#9da7bd',
    lineHeight: '1.6'
  },

  dashboard: {
    maxWidth: '1140px',
    margin: '0 auto 80px',
    padding: '45px',
    borderRadius: '22px',
    background: 'linear-gradient(135deg, #151e38, #17142d)',
    border: '1px solid #2a3452',
    display: 'grid',
    gridTemplateColumns: '1fr auto',
    gap: '40px',
    alignItems: 'center'
  },

  dashboardTitle: {
    fontSize: '34px',
    lineHeight: '1.2',
    margin: 0
  },

  stats: {
    display: 'flex',
    gap: '28px',
    flexWrap: 'wrap'
  },

  stat: {
    display: 'flex',
    flexDirection: 'column',
    gap: '6px'
  },

  statValue: {
    fontSize: '30px'
  },

  statLabel: {
    color: '#9da7bd',
    fontSize: '13px'
  },

  footer: {
    padding: '30px',
    borderTop: '1px solid #202942',
    display: 'flex',
    justifyContent: 'space-between',
    gap: '20px',
    flexWrap: 'wrap',
    color: '#8993aa'
  }

};


export default App;
